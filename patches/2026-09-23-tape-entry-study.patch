+  bool ConfirmedOpaqueEntry(const G4StepPoint* post, const G4ThreeVector& dir,
+                            const G4OpticalSurface* surface, G4double energy) const {
+    if (ForwardInside(post,dir,4.*tolerance_) && ForwardInside(post,dir,8.*tolerance_)) return true;
+    // At the window/wafer/tape corner a grazing ray can remain on the tape's
+    // axial tolerance band at 4*tolerance, despite entering its absorbing bulk.
+    // Extend ONLY the existing zero-R/T/E tape test, never reflective Al.
+    if (!surface || surface->GetName()!="protoGelTapeAbsorber" ||
+        Volume(post)!="protoGelTapePhys") return false;
+    const auto* m=surface->GetMaterialPropertiesTable();
+    auto* r=m ? m->GetProperty(kREFLECTIVITY):nullptr;
+    if (!r || r->Value(energy)!=0.) return false;
+    auto* pv=post->GetPhysicalVolume();
+    auto* touch=dynamic_cast<const G4TouchableHistory*>(post->GetTouchable());
+    if (!pv || !touch) return false;
+    const auto tr=touch->GetHistory()->GetTopTransform();
+    auto* solid=pv->GetLogicalVolume()->GetSolid();
+    if (solid->Inside(tr.TransformPoint(post->GetPosition()+4.*tolerance_*dir))!=kSurface)
+      return false;
+    bool previousInside=false;
+    for (const double multiple : {8.,16.,32.,64.}) {
+      const auto state=solid->Inside(tr.TransformPoint(post->GetPosition()+multiple*tolerance_*dir));
+      if (state==kOutside) return false;
+      if (state==kInside && previousInside) return true;
+      previousInside=state==kInside;
+    }
+    return false;
+  }

# 일렉트론 시뮬레이션 - test_interaction 성공 사례 기반
/control/verbose 2
/run/verbose 1
/run/numberOfThreads 1
/run/initialize

# 일렉트론 입자 설정 - test_interaction과 유사한 설정
/gun/particle e-
/gun/energy 50 MeV
/gun/position 0 0 -1 m
/gun/direction 0 0 1

# 물리적 상호작용 활성화
/process/activate phot
/process/activate compt
/process/activate conv

# 이벤트 수를 100개로 설정
/run/beamOn 100

# control macro for electron batch run without visualization
/control/verbose 2
/run/verbose 1
/run/numberOfThreads 1
/run/initialize

# 일렉트론 입자 설정 - 에너지 증가 및 위치 조정
/gun/particle e-
/gun/energy 100 MeV
/gun/position 0 0 -0.5 m
/gun/direction 0 0 1

# 물리적 상호작용 활성화
/process/activate phot
/process/activate compt
/process/activate conv

/run/beamOn 100
